rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public assets (app icons, logos, etc.)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // User-scoped files - only owner can read/write
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Soma diagnosis document uploads — uid-scoped, write-once, 15MB cap, allowlisted MIME types
    match /diagnoses/{userId}/{diagnosisId}/{filename} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|text/csv|text/plain|image/jpeg|image/png');
      allow update: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}