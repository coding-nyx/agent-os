rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // For now, super-admin-uid or any other admin logic
      return isAuthenticated() && request.auth.uid == 'super-admin-uid';
    }

    // Vault and Core User Data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Module sessions (Android client chat)
      match /modules/{moduleId}/sessions/{sessionId} {
        allow read, write: if isOwner(userId);

        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    match /vaults/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Module Memory and Active Sessions
    match /module_memory/{docId} {
      // docId is uid_moduleId
      allow read, write, delete: if isAuthenticated() && docId.matches('^' + request.auth.uid + '_.+$');
    }

    match /active_sessions/{docId} {
      // docId is uid_moduleId
      allow read, write, delete: if isAuthenticated() && docId.matches('^' + request.auth.uid + '_.+$');
    }
    
    // Therapy Module
    match /therapist_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // AI Trainer Module
    match /ai_trainers/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Soma Module
    match /soma_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Ledger Module
    match /ai_ledgers/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Atlas Module
    match /atlas_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Scout Module
    match /scout_knowledge/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Forge Module
    match /forge_sessions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Pulse Module
    match /pulse_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Global Soul (Integration)
    match /global_souls/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Semantic Memory
    match /semantic_memory/{userId} {
      allow read, write: if isOwner(userId);

      match /facts/{factId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Spine Event Log
    match /spine_events/{userId} {
      allow read, write: if isOwner(userId);

      match /events/{eventId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Bridge Configuration
    match /bridge_config/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Belief Graphs
    match /belief_graphs/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Training Logs
    match /training_logs/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Guest Shadows (for transient state)
    match /guest_shadows/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Titan Fitness / Trainer Portfolio Module
    match /trainers/{userId} {
      // Anyone can read trainer profiles (they are public portfolios)
      allow read: if true; 
      // Only the trainer themselves can write to their root doc
      allow write: if isOwner(userId);

      // Subcollections under a trainer
      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }
    
    // Platform Settings (Landing pages, global testimonials)
    match /platform_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
