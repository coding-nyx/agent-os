rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check for custom claims admin role
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Vault and Core User Data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Explicitly allow all subcollections/paths under users/{userId}
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /vaults/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Module Memory and Active Sessions
    match /module_memory/{docId} {
      // docId is uid_moduleId
      allow read, write, delete: if isAuthenticated() && docId.matches('^' + request.auth.uid + '_.+$');
    }

    // Module profiles (Android module health)
    match /module_profiles/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /active_sessions/{docId} {
      // docId is uid_moduleId
      allow read, write, delete: if isAuthenticated() && docId.matches('^' + request.auth.uid + '_.+$');
    }
    
    // Agnes (Emotional Domain)
    match /agnes_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Titan (Performance Domain)
    match /titan_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Soma (Biological Domain)
    match /soma_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Ledger (Financial Domain)
    match /ledger_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Atlas (Cognitive Domain)
    match /atlas_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Atlas Journal (E2EE private journal entries — separate collection for scalability)
    match /atlas_journals/{userId} {
      allow read, write: if isOwner(userId);

      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Scout (Research Extension)
    match /scout_knowledge/{userId} {
      allow read, write: if isOwner(userId);
      match /nodes/{nodeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Scout Sources Library
    match /scout_sources/{userId} {
      allow read, write: if isOwner(userId);
      match /sources/{sourceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Scout Research Sessions
    match /scout_sessions/{userId} {
      allow read, write: if isOwner(userId);
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Scout Digests
    match /scout_digests/{userId} {
      allow read, write: if isOwner(userId);
      match /digests/{digestId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Forge (Technical Extension)
    match /forge_sessions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Pulse (Interest Extension)
    match /pulse_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Document Intelligence (Cross-module records)
    match /documents/{docId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // Global Soul (System-wide State)
    match /global_souls/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Semantic Memory (Long-term Facts)
    match /semantic_memory/{userId} {
      allow read, write: if isOwner(userId);

      match /facts/{factId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Spine Event Log (Real-time Bus)
    match /spine_events/{userId} {
      allow read, write: if isOwner(userId);

      match /events/{eventId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Belief Graphs (Agnes-specific visual data)
    match /belief_graphs/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Belief Graph Workflows (Agnes proposal + invitation workflow state)
    match /belief_graph_workflows/{userId} {
      allow read, write: if isOwner(userId);
    }

    // RAG Embeddings (Android semantic search index)
    match /rag_embeddings/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // RAG Chunks (semantic search documents)
    match /rag_chunks/{docId} {
      allow read, write: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid);
    }

    // Legacy Portfolio / Public Profiles (Titan Branding)
    match /titan_portfolios/{userId} {
      // Anyone can read public portfolios
      allow read: if true; 
      // Only the owner can write
      allow write: if isOwner(userId);

      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }
    
    // Custom Schema Extensions (user-defined field extensions per module)
    match /custom_schemas/{userId} {
      allow read, write: if isOwner(userId);

      match /modules/{moduleId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Platform Settings (Admin-only configurations)
    match /platform_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat Threads (multi-turn conversation history)
    match /chat_threads/{docId} {
      allow read, write, delete: if isAuthenticated() && docId.matches('^' + request.auth.uid + '_.+$');
    }

    // Notebook Cells (Scout/document workspace)
    match /notebook_cells/{docId} {
      allow read, write, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Derived Insights (cross-module aggregated intelligence)
    match /derived_insights/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Dynamic Extension Field Values (S19-atlas-02)
    match /extension_field_values/{userId} {
      allow read, write: if isOwner(userId);
      match /modules/{moduleId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Notification Inbox (S19-bridge-01)
    match /notification_inbox/{userId} {
      allow read, write: if isOwner(userId);
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Pending Soul Writes (Global State Approvals)
    match /pending_soul_writes/{userId} {
      allow read, write: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Bridge Config (cross-module coordination config)
    match /bridge_config/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Soma Diagnosis Sessions (ephemeral PHI — E2EE, 24h TTL)
    match /soma_diagnoses/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Soma Pending Approvals (agent review queue)
    match /soma_pending_approvals/{userId}/queue/{entryId} {
      allow read, write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
